{
  "name": "daily-english-stage-system",
  "version": "0.4.0",
  "private": true,
  "description": "使用 normalized 全量资料的本地英语（二）阶段学习系统",
  "author": "Daily English",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "start": "vinext start",
    "api:start": "node server/api.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "content:build": "node scripts/build-textbook-course.mjs",
    "vocab:audit": "node scripts/audit-vocabulary-source.mjs",
    "content:audit": "node scripts/audit-textbook-coverage.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
